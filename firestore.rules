rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // follows ドキュメント ID: followerId_followingId
    function isFollowing(followerId, followingId) {
      return exists(/databases/$(database)/documents/follows/$(followerId + '_' + followingId));
    }

    // ─── posts ───────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn()
        && (
          isOwner(resource.data.authorId)
          // いいね・コメント数は ±1 の増減のみ許可（任意の値への改ざんを禁止）
          || (
            request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasOnly(['likesCount'])
            && (request.resource.data.likesCount == resource.data.likesCount + 1
                || request.resource.data.likesCount == resource.data.likesCount - 1)
          )
          || (
            request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasOnly(['commentsCount'])
            && (request.resource.data.commentsCount == resource.data.commentsCount + 1
                || request.resource.data.commentsCount == resource.data.commentsCount - 1)
          )
          || (
            request.auth.uid == resource.data.authorId
            && request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasOnly(['authorName', 'authorPhotoURL', 'authorPlan'])
          )
        );
      allow delete: if isOwner(resource.data.authorId);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn()
          && request.resource.data.authorId == request.auth.uid;
        allow update: if isSignedIn()
          && resource.data.authorId == request.auth.uid
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['authorName', 'authorPhotoURL', 'authorPlan']);
        allow delete: if isSignedIn()
          && resource.data.authorId == request.auth.uid;
      }
    }

    // ─── likes ───────────────────────────────────────────────
    match /likes/{likeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // ─── users ───────────────────────────────────────────────
    // Phase 1: plan / email / uid / createdAt の改ざんを禁止する（他フィールドは
    //          既存コードとの互換のため Phase 2 で段階的に制限する）。
    //          plan は Cloud Functions (Admin SDK) 経由でのみ更新可能。
    match /users/{userId} {
      allow read: if true;

      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.plan == 'free';

      allow update: if (
          isOwner(userId)
          && !request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasAny(['plan', 'email', 'uid', 'createdAt'])
        )
        // フォロー/アンフォロー時に他ユーザーの followersCount を ±1 だけ更新可能
        || (
          isSignedIn()
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['followersCount'])
          && (request.resource.data.followersCount == resource.data.followersCount + 1
              || request.resource.data.followersCount == resource.data.followersCount - 1)
        );

      allow delete: if false;
    }

    // ─── aiUsageDaily (JST 日付単位の AI 利用カウンタ) ─────────
    // Admin SDK のみ書き込み可能。クライアントは自分のカウンタのみ読める。
    match /aiUsageDaily/{docId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // ─── aiReports (AI 分析レポートの Firestore L2 キャッシュ) ──
    match /aiReports/{reportId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // ─── follows ─────────────────────────────────────────────
    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.followerId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.followerId == request.auth.uid;
    }

    // ─── teams ───────────────────────────────────────────────
    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn()
        && (
          resource.data.ownerId == request.auth.uid
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
            && request.resource.data.memberIds.hasAll(resource.data.memberIds)
            && request.auth.uid in request.resource.data.memberIds
          )
        );
      allow delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;

      match /members/{memberId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && (request.auth.uid == memberId
              || request.auth.uid == get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId);
        allow update, delete: if isSignedIn()
          && (request.auth.uid == memberId
              || request.auth.uid == get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId);
      }

      match /players/{playerId} {
        allow read, create, update, delete: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.memberIds;
      }

      match /playerAssignments/{assignmentId} {
        allow read, create, update, delete: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.memberIds;
      }
    }

    // ─── scores ──────────────────────────────────────────────
    match /scores/{scoreId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.playerId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.playerId == request.auth.uid;
    }

    // ─── games ───────────────────────────────────────────────
    match /games/{gameId} {
      allow read: if isSignedIn()
        && (
          resource.data.ownerId == request.auth.uid
          || request.auth.uid in resource.data.get('sharedWith', [])
          || (
            resource.data.get('isShared', false) == true
            && request.auth.uid in resource.data.get('sharedTo', [])
          )
        );
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    // ─── messages (DM) ──────────────────────────────────────
    match /messages/{conversationId} {
      // 未存在ドキュメントの get（getOrCreateConversation の存在確認）を許可する。
      // resource.data のみだと存在しない会話で permission-denied になる。
      allow get: if isSignedIn() && (
        !exists(/databases/$(database)/documents/messages/$(conversationId))
        || request.auth.uid in resource.data.participants
      );
      allow list: if isSignedIn()
        && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/messages/$(conversationId)).data.participants;
        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/messages/$(conversationId)).data.participants
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ─── groups ──────────────────────────────────────────────
    match /groups/{groupId} {
      allow read: if isSignedIn()
        && (
          request.auth.uid in resource.data.memberIds
          || (
            resource.data.teamId != null
            && request.auth.uid in get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.memberIds
          )
        );
      allow create: if isSignedIn();
      allow update: if isSignedIn()
        && (
          request.auth.uid in resource.data.memberIds
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
            && request.resource.data.memberIds.hasAll(resource.data.memberIds)
            && request.auth.uid in request.resource.data.memberIds
          )
        );
      allow delete: if isSignedIn()
        && resource.data.teamId != null
        && request.auth.uid
          == get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.ownerId;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow update, delete: if false;
      }
    }

    // ─── notifications ──────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      // 更新は受信者本人による既読化（read フィールド）のみ
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['read']);
      // 作成は「自分が送信者（fromUserId）」の通知のみ。なりすまし・スパムを防ぐ
      allow create: if isSignedIn()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.userId is string
        && request.resource.data.userId != request.auth.uid
        && request.resource.data.read == false
        && request.resource.data.type in ['follow', 'like', 'comment', 'teamInvite', 'dm'];
      allow delete: if false;
    }

    // ─── spotAtBats ──────────────────────────────────────────
    match /spotAtBats/{docId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // ─── playerMerges (自分専用の選手名寄せメモ) ──────────────
    // docId = uid。本人以外は読み書き不可。
    match /playerMerges/{docId} {
      allow read: if isSignedIn()
        && docId == request.auth.uid;
      allow create, update: if isSignedIn()
        && docId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && docId == request.auth.uid;
    }

    // ─── ballparks ────────────────────────────────────────────
    match /ballparks/{ballparkId} {
      allow read, update, delete: if isSignedIn()
        && request.auth.uid == resource.data.ownerId;
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.ownerId;
    }

    // ─── blockedUsers ─────────────────────────────────────────
    match /blockedUsers/{blockerId}/blocking/{blockedUserId} {
      allow read: if isOwner(blockerId);
      allow create, delete: if isOwner(blockerId);
    }

    // ─── reports ──────────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid;
      allow read: if false;
    }

    // ─── supportReports ───────────────────────────────────────
    match /supportReports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 2000;
      allow read, update, delete: if false;
    }

    // ─── inviteCodes ──────────────────────────────────────────
    // 利用（usedBy 追記・特典付与）は Cloud Functions (redeemInviteCode) のみ。
    // クライアントは登録時の自分のコード作成のみ可能。
    match /inviteCodes/{inviteCode} {
      allow get, list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if false;
    }

    // ─── deviceRegistry ───────────────────────────────────────
    // Cloud Functions (Admin SDK) のみ読み書き可能
    match /deviceRegistry/{deviceId} {
      allow read, write: if false;
    }

    // ─── aiUsageEvents ────────────────────────────────────────
    // Cloud Functions (Admin SDK) のみ書き込み可能。本人は自分の利用量のみ参照できる。
    match /aiUsageEvents/{eventId} {
      allow read: if isSignedIn()
        && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }
  }
}
