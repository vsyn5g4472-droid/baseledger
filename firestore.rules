rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ─── posts ───────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid;
      allow update: if isOwner(resource.data.authorId);
      allow delete: if isOwner(resource.data.authorId);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow delete: if isSignedIn()
          && resource.data.authorId == request.auth.uid;
      }
    }

    // ─── likes ───────────────────────────────────────────────
    match /likes/{likeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // ─── users ───────────────────────────────────────────────
    // Phase 1: plan / email / uid / createdAt の改ざんを禁止する（他フィールドは
    //          既存コードとの互換のため Phase 2 で段階的に制限する）。
    //          plan は Cloud Functions (Admin SDK) 経由でのみ更新可能。
    match /users/{userId} {
      allow read: if true;

      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.plan == 'free';

      allow update: if isOwner(userId)
          && !request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasAny(['plan', 'email', 'uid', 'createdAt'])
        || (isSignedIn()
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['followersCount']));

      allow delete: if false;
    }

    // ─── aiUsageDaily (JST 日付単位の AI 利用カウンタ) ─────────
    // Admin SDK のみ書き込み可能。クライアントは自分のカウンタのみ読める。
    match /aiUsageDaily/{docId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // ─── aiReports (AI 分析レポートの Firestore L2 キャッシュ) ──
    match /aiReports/{reportId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // ─── follows ─────────────────────────────────────────────
    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.followerId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.followerId == request.auth.uid;
    }

    // ─── teams ───────────────────────────────────────────────
    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn()
        && (
          resource.data.ownerId == request.auth.uid
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
            && request.resource.data.memberIds.hasAll(resource.data.memberIds)
            && request.auth.uid in request.resource.data.memberIds
          )
        );
      allow delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;

      match /members/{memberId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && (request.auth.uid == memberId
              || request.auth.uid == get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId);
        allow update, delete: if isSignedIn()
          && (request.auth.uid == memberId
              || request.auth.uid == get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId);
      }
    }

    // ─── scores ──────────────────────────────────────────────
    match /scores/{scoreId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.playerId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.playerId == request.auth.uid;
    }

    // ─── games ───────────────────────────────────────────────
    match /games/{gameId} {
      allow read: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
      allow delete: if false;
    }

    // ─── messages (DM) ──────────────────────────────────────
    match /messages/{conversationId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/messages/$(conversationId)).data.participants;
        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/messages/$(conversationId)).data.participants
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ─── groups ──────────────────────────────────────────────
    match /groups/{groupId} {
      allow read: if isSignedIn()
        && (
          request.auth.uid in resource.data.memberIds
          || (
            resource.data.teamId != null
            && request.auth.uid in get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.memberIds
          )
        );
      allow create: if isSignedIn();
      allow update: if isSignedIn()
        && (
          request.auth.uid in resource.data.memberIds
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
            && request.resource.data.memberIds.hasAll(resource.data.memberIds)
            && request.auth.uid in request.resource.data.memberIds
          )
        );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow update, delete: if false;
      }
    }

    // ─── notifications ──────────────────────────────────────
    match /notifications/{notificationId} {
      allow read, update: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow delete: if false;
    }
  }
}
