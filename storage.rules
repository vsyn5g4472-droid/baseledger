rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|gif|webp|heic|heif)');
    }

    function isVideo() {
      return request.resource.contentType.matches('video/(mp4|quicktime|x-msvideo)');
    }

    function isAllowedMedia() {
      return isImage() || isVideo();
    }

    function isValidImageSize() {
      return request.resource.size <= 10 * 1024 * 1024;
    }

    function isValidVideoSize() {
      return request.resource.size <= 100 * 1024 * 1024;
    }

    function isValidFileSize() {
      return (isImage() && isValidImageSize())
          || (isVideo() && isValidVideoSize());
    }

    // プロフィールアイコン: users/{uid}/avatar.jpg
    // 読み取り: 全員可 / 書き込み: 本人のみ
    match /users/{userId}/avatar.jpg {
      allow read: if true;
      allow write: if isOwner(userId) && isImage() && isValidImageSize();
      allow delete: if isOwner(userId);
    }

    // その他のユーザーファイル
    match /users/{userId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId) && isImage() && isValidImageSize();
      allow delete: if isOwner(userId);
    }

    // 投稿メディア: posts/{postId}/{fileName}
    // 新規アップロードのみ許可。既存ファイルの上書き・削除は禁止
    match /posts/{postId}/{fileName} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && isAllowedMedia()
        && isValidFileSize();
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
