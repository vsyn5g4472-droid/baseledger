# Firebase Configuration
EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id

# Google OAuth (from Firebase Console → Authentication → Google → Web client ID)
# iOS client ID is from GoogleService-Info.plist
# Android client ID is from google-services.json
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# Set to "true" to use mock auth during local development (no Firebase credentials needed)
EXPO_PUBLIC_USE_MOCK_AUTH=true

# Grok API (xAI)
EXPO_PUBLIC_GROK_API_KEY=your-grok-api-key

# Anthropic API — AI解析レポート生成に使用
# https://console.anthropic.com/ でAPIキーを取得
EXPO_PUBLIC_ANTHROPIC_API_KEY=your-anthropic-api-key

# Google Custom Search API — 球歴.com ドラフト情報取得に使用
# 1. https://console.cloud.google.com/ で Custom Search API を有効化
# 2. APIキーを発行して下記に設定
# 3. https://programmablesearchengine.google.com/ でカスタム検索エンジンを作成し CX ID を取得
EXPO_PUBLIC_GOOGLE_SEARCH_API_KEY=your-google-search-api-key
EXPO_PUBLIC_GOOGLE_SEARCH_CX=your-custom-search-engine-cx-id
